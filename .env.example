# ==============================================================================
# SmartInventory Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# 1. Database Configuration
# The PostgreSQL connection URI used by the api/inventory/commit gateway route
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartinventory"

# 2. Ultralytics YOLO REST API Configuration
# Get your API key from Settings > API Keys in the Ultralytics HUB (https://hub.ultralytics.com)
ULTRALYTICS_API_KEY="your_ultralytics_hub_api_key_here"

# Model ID of the YOLOv8 model deployed in the Ultralytics HUB (default: yolov8n)
ULTRALYTICS_MODEL_ID="yolov8n"

# Optional: Dedicated custom API endpoint URL. Defaults to platform API if omitted.
# ULTRALYTICS_API_URL="https://api.ultralytics.com/v1/predict/yolov8n"
